{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.41",
        "--headless",
        "--executable-path",
        "/opt/pw-browsers/chromium-1243/chrome-linux64/chrome"
      ],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@1.0.17"
      ],
      "env": {}
    },
    "postgres": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "postgres-mcp",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://sgt:sgt_dev_only@localhost:5432/sgt_dev"
      }
    }
  }
}
