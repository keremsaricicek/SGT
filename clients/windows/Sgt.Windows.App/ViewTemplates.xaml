<!--
  ViewModel → View eşlemesi. Ekran penceresi (ScreenWindow) içeriği ViewModel tipine göre buradan seçilir.
  Yeni ekran = Core'da ViewModel + burada bir DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cage="clr-namespace:Sgt.Windows.Core.Features.Cage;assembly=Sgt.Windows.Core"
                    xmlns:players="clr-namespace:Sgt.Windows.Core.Features.Players;assembly=Sgt.Windows.Core"
                    xmlns:floor="clr-namespace:Sgt.Windows.Core.Features.Floor;assembly=Sgt.Windows.Core"
                    xmlns:cageViews="clr-namespace:Sgt.Windows.App.Features.Cage"
                    xmlns:playerViews="clr-namespace:Sgt.Windows.App.Features.Players"
                    xmlns:floorViews="clr-namespace:Sgt.Windows.App.Features.Floor">

    <DataTemplate DataType="{x:Type cage:CashierShiftViewModel}">
        <cageViews:CashierShiftView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type cage:CageTransactionViewModel}">
        <cageViews:CageTransactionView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type cage:ShiftSummaryViewModel}">
        <cageViews:ShiftSummaryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type cage:AdjustmentRequestViewModel}">
        <cageViews:AdjustmentRequestView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type players:PlayerSearchViewModel}">
        <playerViews:PlayerSearchView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type players:PlayerDetailViewModel}">
        <playerViews:PlayerDetailView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type floor:TablesViewModel}">
        <floorViews:TablesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type floor:RatingViewModel}">
        <floorViews:RatingView />
    </DataTemplate>
</ResourceDictionary>
