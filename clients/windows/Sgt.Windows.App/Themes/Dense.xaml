<!-- Yoğun, klavye odaklı operasyon görünümü: küçük boşluklar, belirgin odak, kısa satırlar. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Sgt.Windows.App.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />

    <SolidColorBrush x:Key="ErrorBackground" Color="#FDECEA" />
    <SolidColorBrush x:Key="ErrorBorder" Color="#D9534F" />
    <SolidColorBrush x:Key="InfoBackground" Color="#EAF4EA" />
    <SolidColorBrush x:Key="InfoBorder" Color="#4C9A4C" />
    <SolidColorBrush x:Key="MutedText" Color="#555555" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#F0F2F5" />

    <Style TargetType="Window">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Padding" Value="0,2,6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinWidth" Value="80" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Margin" Value="0,2,6,2" />
        <Setter Property="MinWidth" Value="72" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="RowHeight" Value="22" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E3E3E3" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2" />
    </Style>
</ResourceDictionary>
