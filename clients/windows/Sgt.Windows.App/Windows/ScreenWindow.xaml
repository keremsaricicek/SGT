<!-- Ekran penceresi: içerik ViewModel tipine göre ViewTemplates.xaml'daki görünümle çizilir. Esc pencereyi kapatır. -->
<Window x:Class="Sgt.Windows.App.Windows.ScreenWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="{Binding Title}"
        Width="820" Height="560" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnClose" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    </Window.InputBindings>
    <ContentControl Content="{Binding}" Margin="8" Focusable="False" />
</Window>
