<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF kabuğu: yalnızca View (XAML), pencere servisi ve DI kurulumu. İş mantığı Sgt.Windows.Core'dadır. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Sgt.Windows.App</RootNamespace>
    <AssemblyName>SgtWindows</AssemblyName>
    <NeutralLanguage>tr</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sgt.Windows.Core\Sgt.Windows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
