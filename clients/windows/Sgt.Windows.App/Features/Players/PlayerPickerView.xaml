<!-- Oyuncu arama/seçme parçası. DataContext: PlayerPickerViewModel. Enter arar; ok tuşlarıyla sonuç seçilir. -->
<UserControl x:Class="Sgt.Windows.App.Features.Players.PlayerPickerView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:Sgt.Windows.Core.Localization;assembly=Sgt.Windows.Core"
             xmlns:players="clr-namespace:Sgt.Windows.Core.Features.Players;assembly=Sgt.Windows.Core"
             xmlns:controls="clr-namespace:Sgt.Windows.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=players:PlayerPickerViewModel}">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Target="{Binding ElementName=TermBox}" Content="{x:Static loc:Strings.Players_Term}" />
            <TextBox x:Name="TermBox" Grid.Column="1" Text="{Binding Term, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Margin="6,2,0,2" Command="{Binding SearchCommand}">
                <AccessText Text="{x:Static loc:Strings.Players_Search}" />
            </Button>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.Players_MinLength}" Style="{StaticResource Hint}"
                   Visibility="{Binding TermTooShort, Converter={StaticResource BoolToVisibility}}" />
        <controls:MessageBar DockPanel.Dock="Bottom" />
        <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" IsReadOnly="True" MinHeight="80">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static loc:Strings.Players_Number}" Binding="{Binding PlayerNumber}" Width="90" />
                <DataGridTextColumn Header="{x:Static loc:Strings.Players_Name}" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="{x:Static loc:Strings.Players_Card}" Binding="{Binding ActiveCardNumber}" Width="110" />
                <DataGridCheckBoxColumn Header="{x:Static loc:Strings.Players_Restricted}" Binding="{Binding IsRestricted}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
