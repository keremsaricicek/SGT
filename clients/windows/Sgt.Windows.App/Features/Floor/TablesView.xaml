<!-- Masalar (C1) ve masa aç/kapat (C2). Aç/kapat butonları yalnızca yetki varsa görünür. F5 yeniler. -->
<UserControl x:Class="Sgt.Windows.App.Features.Floor.TablesView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:Sgt.Windows.Core.Localization;assembly=Sgt.Windows.Core"
             xmlns:floor="clr-namespace:Sgt.Windows.Core.Features.Floor;assembly=Sgt.Windows.Core"
             xmlns:controls="clr-namespace:Sgt.Windows.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=floor:TablesViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal">
                <Label Target="{Binding ElementName=ReasonBox}" Content="{x:Static loc:Strings.Cage_Reason}" />
                <TextBox x:Name="ReasonBox" Width="180" Text="{Binding ReasonCode, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper" MaxLength="50" Margin="0,2,8,2" />
                <Button Command="{Binding OpenTableCommand}" Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding CanOpenTables, Converter={StaticResource BoolToVisibility}}">
                    <AccessText Text="{x:Static loc:Strings.Floor_OpenTable}" />
                </Button>
                <Button Command="{Binding CloseTableCommand}"
                        Visibility="{Binding CanCloseTables, Converter={StaticResource BoolToVisibility}}">
                    <AccessText Text="{x:Static loc:Strings.Floor_CloseTable}" />
                </Button>
                <Button Command="{Binding RefreshCommand}">
                    <AccessText Text="{x:Static loc:Strings.Cage_Refresh}" />
                </Button>
            </StackPanel>
            <controls:MessageBar />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static loc:Strings.Floor_Code}" Binding="{Binding Code}" Width="90" />
                <DataGridTextColumn Header="{x:Static loc:Strings.Floor_Game}" Binding="{Binding GameType}" Width="*" />
                <DataGridTextColumn Header="{x:Static loc:Strings.Cage_Currency}" Binding="{Binding Currency}" Width="60" />
                <DataGridTextColumn Header="{x:Static loc:Strings.Floor_MinBet}" Binding="{Binding MinBet, StringFormat=N0}" Width="90" />
                <DataGridTextColumn Header="{x:Static loc:Strings.Floor_MaxBet}" Binding="{Binding MaxBet, StringFormat=N0}" Width="90" />
                <DataGridCheckBoxColumn Header="{x:Static loc:Strings.Floor_Open}" Binding="{Binding IsOpen}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
