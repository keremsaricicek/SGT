<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF'e bağımlı değildir: ViewModel, API istemcisi ve servisler Linux'ta da derlenir ve test edilir. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sgt.Windows.Core</RootNamespace>
    <NeutralLanguage>tr</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sgt.Windows.Core.Tests" />
  </ItemGroup>

  <!-- Arayüz metinleri: Strings.resx Türkçe (varsayılan), Strings.en.resx İngilizce. Sınıf derlemede üretilir. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Sgt.Windows.Core.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
