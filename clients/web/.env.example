# Örnek yapılandırma. Kopyalayıp .env.local yapın; .env.local repoya girmez.
# Bu değerler tarayıcıya gömülür: buraya asla secret yazmayın (istemci "public client"tır, PKCE kullanır).

# Keycloak realm adresi (OIDC authority)
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8080/realms/sgt
# Keycloak'ta tanımlı public client kimliği
NEXT_PUBLIC_OIDC_CLIENT_ID=sgt-web
# İsteğe bağlı; varsayılan "openid profile"
# NEXT_PUBLIC_OIDC_SCOPE=openid profile

# API kök adresi (sonunda / olmadan). Boş bırakılırsa istekler aynı kökene gider.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# İsteğe bağlı: tarayıcıda kayıtlı terminal adı yoksa kullanılacak ad (X-Terminal)
# NEXT_PUBLIC_DEFAULT_TERMINAL=WEB-OFIS

# İsteğe bağlı (yalnızca sunucu): /api/v1/* isteklerini Next sunucusu üzerinden API'ye aktarır.
# Kullanılırsa NEXT_PUBLIC_API_BASE_URL boş bırakılır ve API'de CORS gerekmez.
# SGT_API_PROXY_TARGET=http://localhost:5000
