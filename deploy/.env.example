# SGT yerel geliştirme / pilot ortamı — ortam değişkenleri şablonu
#
# Kullanım:  cp deploy/.env.example deploy/.env   (sonra değerleri değiştirin)
# deploy/.env dosyası .gitignore'dadır; ASLA repoya eklenmez.
#
# !!! Aşağıdaki "dev_only" / "Dev-Only" değerler YALNIZCA kendi bilgisayarınızda geliştirme içindir.
# !!! Pilot veya üretim kurulumunda HER BİRİ değiştirilir; üretimde secret manager kullanılır (docs/kurulum.md).

# --- PostgreSQL (SGT veritabanı) ---
POSTGRES_DB=sgt_dev
POSTGRES_USER=sgt
POSTGRES_PASSWORD=sgt_dev_only
# Sunucunun dışarıya açılan portu (bilgisayarınızdaki 5432 doluysa değiştirin)
POSTGRES_PORT=5432

# --- Keycloak (giriş sistemi) ---
# Keycloak kendi verisini aynı PostgreSQL'de ayrı "keycloak" veritabanında tutar.
KEYCLOAK_DB_PASSWORD=keycloak_dev_only
# Keycloak yönetim konsolu (http://localhost:8080/admin) ilk yönetici hesabı — DEV ONLY
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=Kc-Admin-Dev-Only-1
KEYCLOAK_PORT=8080
# Tarayıcının Keycloak'a ulaştığı adres. Token içindeki "iss" bu adres olur.
KC_HOSTNAME_URL=http://localhost:8080

# MFA (tek kullanımlık kod / OTP):
#   CONDITIONAL = yalnızca OTP kurmuş kullanıcıya sorulur (geliştirme varsayılanı)
#   REQUIRED    = herkes ilk girişte OTP kurar ve her girişte kod girer (pilot/üretim: ZORUNLU)
SGT_OTP_REQUIREMENT=CONDITIONAL

# Komut satırından (curl) token almak için şifreli doğrudan giriş. YALNIZCA geliştirme.
# Pilot/üretimde false olmalı.
SGT_DEV_DIRECT_GRANT=true

# Sentetik geliştirme kullanıcılarının şifreleri — DEV ONLY (gerçek kişi değildir)
SGT_DEV_SUPERADMIN_PASSWORD=Superadmin-Dev-Only-1
SGT_DEV_KASIYER1_PASSWORD=Kasiyer1-Dev-Only-1

# --- SGT API (yalnızca "--profile api" ile çalıştırıldığında) ---
API_PORT=5080
# Development: API açılışta veritabanı tablolarını (migration) kurar ve ilk süper admin yetkisini ekler.
ASPNETCORE_ENVIRONMENT=Development
SGT_TENANT_ID=00000000-0000-0000-0000-0000000000a1
SGT_SUPERADMIN_USER_ID=00000000-0000-0000-0000-000000000001
# Kişisel veri şifreleme anahtarları (ADR-0005). Aşağıdakiler appsettings.Development.json'daki
# GELİŞTİRME anahtarlarıdır — DEV ONLY. Gerçek kurulumda yeni üretin:  openssl rand -base64 32
SGT_PERSONAL_DATA_KEY=wz7Pft1Uf/dxzioMSNg6IHyb2IS6J5BbyIxqDOkcIhE=
SGT_BLIND_INDEX_KEY=5jUACDhxfhkX1un9Fpb3ufEdUwkiLKem+W71O3fN6mI=
